# Copy to backend/.env and fill in real values for local dev.
# docker-compose overrides DATABASE_URL / REDIS_URL / S3_ENDPOINT_URL to point at
# the container network — the values below are for running the API on bare metal.

ENVIRONMENT=local
DEBUG=true

CORS_ORIGINS=["http://localhost:3000"]

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/docintel
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:postgres@localhost:5432/docintel

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

JWT_SECRET_KEY=replace-with-a-long-random-secret

S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=documents

# LLM provider — Section 14 $0 stack default. Get a free key at https://console.groq.com
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional paid upgrade (Section 2)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Embeddings — local sentence-transformers, no API key needed
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384
